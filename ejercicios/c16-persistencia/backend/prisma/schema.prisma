generator client {
  provider = "prisma-client"           // ← Prisma 7. NO "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model Libro {
  id         Int     @id @default(autoincrement())
  titulo     String
  autor      String        
  precio     Int
  imagen     String
  disponible Boolean @default(true)
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique
  nacionalidad String
}