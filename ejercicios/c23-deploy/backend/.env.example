# Copiá este archivo a .env y completá los valores. El .env NO va a Git.
# En producción (Render) estas variables se cargan en el panel del servicio, no en un archivo.

# ---- Servidor ----
NODE_ENV=development
PORT=3000                                 # en Render la inyecta la plataforma: no la cargues
FRONTEND_URL=http://localhost:5173        # en prod: la URL del Static Site, sin barra al final (CORS)

# ---- Postgres local (docker compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}
# en prod: la connection string directa de Neon (postgresql://…@ep-….neon.tech/neondb?sslmode=require…)

# ---- Prisma: menos ruido en la consola ----
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# ---- Auth ----
JWT_SECRET=cambiame_por_una_cadena_larga_y_aleatoria   # en prod: generado con el botón de Render, nunca este valor
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10