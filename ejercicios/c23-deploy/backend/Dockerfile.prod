# Imagen de PRODUCCIÓN del backend. La de desarrollo sigue siendo ./Dockerfile (docker compose).
# Dos etapas: la primera compila, la segunda se queda sólo con lo que hace falta para correr.

# ---------- Etapa 1: build ----------
FROM node:22-alpine AS build
WORKDIR /app

# Instala TODO (incluye devDependencies: typescript, prisma CLI). Capa aparte para cachear.
COPY package*.json ./
RUN npm ci

# El resto del código (.dockerignore deja afuera node_modules, dist, .env, src/generated)
COPY . .

# Genera el cliente de Prisma (no necesita DATABASE_URL) y compila TS → dist/ (sin tests)
RUN npx prisma generate && npm run build

# ---------- Etapa 2: runtime ----------
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production

# node_modules viene de la etapa 1: un solo npm ci. El CLI de Prisma queda adentro: migra al arrancar.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma

# Render inyecta PORT; Express lo lee de process.env.PORT (default 3000 para correr local)
EXPOSE 3000

# 1) aplica las migraciones commiteadas  2) arranca. Si 1) falla, el deploy falla y sigue la versión anterior.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]